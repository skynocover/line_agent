{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-agent-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-13",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  "r2_buckets": [
    {
      "binding": "APP_STORAGE",
		  "bucket_name": "line-agent-storage",
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-agent-database",
      "database_id": "n/a",
      "migrations_dir": "./drizzle"
    }
  ],
  "env":{
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "line-agent-database",
          "database_id": "b4590b7f-ec25-4044-9ff3-140f68e3c720",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "APP_STORAGE",
          "bucket_name": "line-agent-storage"
        }
      ],
      // 生產環境也添加預熱觸發器
      "triggers": {
        "crons": ["*/15 * * * *"]
      }
    }
  },
  // "ai": {
  //   "binding": "AI"
  // },
  "observability": {
    "enabled": true
  }
}
